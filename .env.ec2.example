# Non-secret deployment settings only. Never add passwords or AWS keys here.
AWS_REGION=ap-northeast-2
BACKEND_IMAGE=ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com/hobbytree/backend:COMMIT_SHA
DB_SECRET_ID=REPLACE_WITH_APP_SECRET_ARN_OR_NAME
AUTH_SECRET_ID=REPLACE_WITH_AUTH_SECRET_ARN_OR_NAME
# Explicit ALB subnets; never trust the whole VPC or Docker bridge by default.
AUTH_TRUSTED_PROXY_CIDRS=REPLACE_WITH_ALB_SUBNET_CIDRS
# Optional short-lived peer-only deployment diagnostics; no forwarded headers/tokens are logged.
LOGGING_LEVEL_HOBBYTREE_AUTH_PROXY=INFO
KAKAO_APP_ID=REPLACE_WITH_NUMERIC_APP_ID
GOOGLE_CLIENT_ID=REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_SECRETS_DIR=/run/hobbytree/redis-secrets
DB_APP_USERNAME=hobbytree_app
DB_URL='jdbc:postgresql://REPLACE_WITH_RDS_ENDPOINT:5432/hobbytree?sslmode=verify-full&sslrootcert=/etc/hobbytree/certs/rds-ca.pem'
APP_SECRETS_DIR=/run/hobbytree/secrets
RDS_CA_BUNDLE=/opt/hobbytree/certs/rds-ca.pem
# Host interface for published backend port. Set 0.0.0.0 on EC2 only with restricted security group.
BACKEND_BIND_IP=0.0.0.0
