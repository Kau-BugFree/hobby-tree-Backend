# Copy to .env. Keep actual credentials out of Git.
# One NAME=value per line. Optional matching quotes are supported.
# Use separate comment lines; interpolation and inline comments are not supported.
DB_URL=jdbc:postgresql://localhost:5433/hobbytree
DB_USERNAME=hobbytree
DB_PASSWORD=

# Local Redis port published by compose.yml.
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=

# Required for social login. Google uses the Web/server client ID.
# JWT_SECRET: Base64-encoded cryptographically random key, at least 64 bytes.
KAKAO_APP_ID=
GOOGLE_CLIENT_ID=
JWT_SECRET=
