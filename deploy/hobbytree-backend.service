[Unit]
Description=HobbyTree EC2 Compose backend
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=900
StartLimitBurst=5

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/hobbytree
EnvironmentFile=/opt/hobbytree/.env.ec2
ExecStartPre=/usr/bin/python3 /opt/hobbytree/scripts/validate-ec2-config.py --env-file /opt/hobbytree/.env.ec2
ExecStartPre=/usr/bin/python3 /opt/hobbytree/scripts/fetch-ec2-secrets.py --secret-id ${DB_SECRET_ID} --expected-username ${DB_APP_USERNAME} --region ${AWS_REGION} --output-dir ${APP_SECRETS_DIR}
ExecStart=/usr/bin/docker compose --env-file /opt/hobbytree/.env.ec2 -f /opt/hobbytree/compose.ec2.yml up -d --no-build --force-recreate --wait --wait-timeout 120
ExecStop=/usr/bin/docker compose --env-file /opt/hobbytree/.env.ec2 -f /opt/hobbytree/compose.ec2.yml stop
TimeoutStartSec=240
TimeoutStopSec=60
Restart=on-failure
RestartSec=20s

[Install]
WantedBy=multi-user.target
